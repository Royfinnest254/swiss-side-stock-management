# Server
PORT=3000
ALLOWED_ORIGIN=https://yourdomain.com
JWT_SECRET=replace_with_64_random_characters
JWT_EXPIRES_IN=24h

# Database (from cPanel > MySQL Databases)
DB_HOST=localhost
DB_USER=cpanelusername_dbuser
DB_PASSWORD=your_db_password
DB_NAME=cpanelusername_dbname

# Email (from cPanel > Email Accounts)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your_email_password
EMAIL_FROM="Swiss Side <noreply@yourdomain.com>"
